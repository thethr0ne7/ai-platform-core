NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SHA-256 hex digest of the shared secret sent by callers of /api/source-relay
# in the x-source-relay-token header. Compute with:
#   node -e "console.log(require('crypto').createHash('sha256').update('<token>').digest('hex'))"
# Rotate by generating a new token, updating this hash and the caller's copy of
# the plaintext token together. Do not commit the plaintext token anywhere.
SOURCE_RELAY_TOKEN_HASH=
